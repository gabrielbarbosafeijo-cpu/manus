<!-- 4. SCRIPT — cole logo após o div#tc-intro -->
<script>
(function () {
  'use strict';
  var CFG = { autoExit: 7000, exitDuration: 1600 };
  var intro = document.getElementById('tc-intro');
  var skip  = document.getElementById('tc-skip');
  if (!intro) return;

  document.documentElement.style.overflow = 'hidden';
  document.body.style.overflow = 'hidden';

  var done = false;
  function exit() {
    if (done) return;
    done = true;
    intro.classList.add('tc--exit');
    setTimeout(function () {
      intro.style.display = 'none';
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      window.dispatchEvent(new CustomEvent('tcIntroComplete'));
    }, CFG.exitDuration);
  }

  var timer = setTimeout(exit, CFG.autoExit);
  function early() { clearTimeout(timer); exit(); }

  skip.addEventListener('click', function(e) { e.stopPropagation(); early(); });
  document.addEventListener('keydown', function h(e) {
    if (e.key==='Escape'||e.key===' '||e.key==='Enter') {
      document.removeEventListener('keydown', h); early();
    }
  });
  setTimeout(function() {
    if (!done) intro.addEventListener('click', early, { once: true });
  }, 3000);

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    clearTimeout(timer); setTimeout(exit, 300);
  }
}());
</script>
